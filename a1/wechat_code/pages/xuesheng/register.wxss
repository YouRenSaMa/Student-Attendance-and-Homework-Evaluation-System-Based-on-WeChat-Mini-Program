/* pages/register/register.wxss */

.register-container {
width
:100%;
padding
:12px 12px 12px 12px;
background
:url(http://clfile.zggen.cn/20250106/9fb006aae1a3487e87129419964d27dd.gif) no-repeat center  center / 100% 100%;
}
.register-container {
