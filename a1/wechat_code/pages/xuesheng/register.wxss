:0 0 20px 0;
height
:auto;
}
input{
width:90%!important;
border
:0px solid #ffaa33;
padding
:0 12px;
box-shadow
:0px 4px 4px 0px #000000;
margin
:0 0 0 0;
color
:#000;
border-radius
:4px;
background
:#fff;
width
:100%;
font-size
:14px;
height
:44px;
}
.select-date{

border
:0px solid #ffaa33;

