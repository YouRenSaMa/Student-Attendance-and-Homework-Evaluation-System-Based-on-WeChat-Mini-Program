<view class="register-container">
<view class="content">
<view class="avatar-box">
<image class="avatar" src="http://codegen.caihongy.cn/20201114/7856ba26477849ea828f481fa2773a95.jpg" mode="aspectFit" />
</view>
<view class="box">
<input type="text" placeholder="学号" model:value="{{xuehao}}"  />
</view>
<view class="box">
    <input type="password" placeholder="请输入密码"     model:value="{{mima}}" />
</view>
<view class="box">
<input type="password" placeholder="请确认密码"     model:value="{{mima2}}"/>
</view>
    <view class="box">
        <input type="text" placeholder="学生姓名" model:value="{{xueshengxingming}}" />
    </view>
    <view class="box">
        <input type="text" placeholder="学生手机" model:value="{{xueshengshouji}}" />
    </view>
    <view class="box">
        <input type="text" placeholder="班级" model:value="{{banji}}" />
    </view>
<view  class="box-uploadBox">
    <image class="upload-img"   bindtap="touxiangTap"   src="{{tempPathtouxiang}}" mode="aspectFill"></image>
