<view class="detail-container" >
<view class="content"   bind:tap="authTap">
<swiper indicator-dots="{{false}}" autoplay="{{false}}" interval="{{5000}}" class="swiper" vertical="{{false}}" interval="{{5000}}" duration="{{500}}"  indicator-color='#00000030'   indicator-active-color="#000000"   autoplay="{{false}}"  circular="{{false}}">
<swiper-item class="swiper-item"  wx:for="{{picture}}"  bindtap="previewImgTap"  data-currenturl="{{baseURL + item}}"  wx:key="index">
    <image src="{{baseURL+item}}" mode="aspectFit"   class="swiper-img"></image>
    <view   wx:if="$conf.menu.flag"  class="swiper-title">{{item.title}}</view>
</swiper-item>
</swiper>
<view class="detail-box">


<view class="detail-item-box" >
<view class="detail-item-label">作业名称：</view>
<view class="detail-item-text">{{detailList.zuoyemingcheng}}</view>
</view>

<view class="detail-item-box" >
<view class="detail-item-label">学号：</view>
<view class="detail-item-text">{{detailList.xuehao}}</view>
</view>


<view class="detail-item-box" >
<view class="detail-item-label">学生姓名：</view>
<view class="detail-item-text">{{detailList.xueshengxingming}}</view>
</view>

<view class="detail-item-box" >
<view class="detail-item-label">班级：</view>
<view class="detail-item-text">{{detailList.banji}}</view>
</view>


<view class="detail-item-box" >
<view class="detail-item-label">提交时间：</view>
<view class="detail-item-text">{{detailList.tijiaoshijian}}</view>
</view>


<view class="detail-item-box" >
<view class="detail-item-label">状态：</view>
<view class="detail-item-text">{{detailList.zhuangtai}}</view>
</view>










<view class="textarea-box">
<view class="textarea-label">提交作业内容</view>
<view class="textarea-text">
    <rich-text nodes="{{detailList.tijiaozuoyeneirong}}"></rich-text>
</view>
</view>


</view>

<view class="operate-box">

<view   wx:if="{{zuoyepigaiisAuthFront}}"  >
    <button class="common-btn"   data-info="zuoyepigai,'','zhuangtai','该作业已批改',zhuangtaiCrossSelect[0]" bind:tap="onAcrossTap" >
作业批改</button>
</view>
<view wx:else="">
    <button class="common-btn" wx:if="{{isAuthzuoyepigai}}"  data-info="zuoyepigai,'','zhuangtai','该作业已批改',zhuangtaiCrossSelect[0]" bind:tap="onAcrossTap" >
        作业批改</button>
</view>







</view>

</view>




</view>