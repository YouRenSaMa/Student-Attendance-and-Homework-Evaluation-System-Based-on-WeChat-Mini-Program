.forgot-container {
min-height
:100vh;
width
:100%;
padding
:12px 12px 12px 12px;
position
:relative;
background
:#FFFFFF;
height
:100%;
}

.forgot-content {
overflow: hidden;
padding
:10px 0;
margin
:0 20px;
border-radius
:10px;
background
:#FFF;
display
:block;
width
:calc(100% - 40px);
height
:auto;
}
.box{
    border
:0px solid #ffaa33;
    padding
:0 12px;
    box-shadow
:0px 4px 4px 0px #000000;
    margin
:0 0 20px 0;
    border-color
:#ccc;
    align-items
:center;
    color
:#000;
    display
:flex;
    border-radius
:4px;
    border-width
:0 0 1px 0;
    background
:#fff;
    width
:100%;
    font-size
:14px;
    border-style
:solid;
    height
:auto;
}
input{
border
:0;
padding
:0px 12px 0px 12px;
margin
:0 0 0 0;
color
:#000;
border-radius
:4px;
background
:#ffffff00;
flex
:1;
width
:100%;
font-size
:14px;
height
:40px;
}



.next-btn {
    border
:0;
    padding
:0 0 0 0;
    box-shadow
: 0px 4px 4px 0px #000000;
    margin
:0 0 12px 0;
    color
:#FFFFFF;
    border-radius
:5px;
    background
:linear-gradient(135.00deg, #F3674A 0%,#FFB956 100%);
    width
:100%;
    line-height
:44px;
    font-size
:16px;
    font-weight
:700;
    height
:44px;
}

