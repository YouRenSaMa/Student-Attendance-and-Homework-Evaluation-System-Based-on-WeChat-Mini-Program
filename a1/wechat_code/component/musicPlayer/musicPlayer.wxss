.page {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    /* padding: 20px 20px 0 20px; */
    padding:10px 5px 5px 5px;
    box-sizing: border-box;
    background: #fff;
    box-shadow: 0 -4px 10px rgba(0, 0, 0, .3);
}

.listBG {
    position: fixed;
    left: 0;
    top: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(0, 0, 0, .3);
    z-index: 998;
}
.music {
    width: 100%;
    padding: 0 24px;
    box-sizing: border-box;
    border-bottom: 1px solid #ddd;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #ddd;
}
.left {
    width: 15%;
    font-size: 28px;
    text-align: center;
    padding-right: 20px;
}

.center {
    width: 75%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.8;
    padding: 10px 0;
}

.name {
    font-size: 32px;
    display: inline-block;
      white-space: nowrap; 
      width: 90%; 
      overflow: hidden;
      text-overflow:ellipsis;
}
.singer {
    font-size: 26px;
    color: #ccc;
    display: inline-block;
      white-space: nowrap; 
      width: 90%; 
      overflow: hidden;
      text-overflow:ellipsis;
}
.right {
    width: 10%;
}
.right image {
    width: 36px;
}
.music:last-of-type {
    border: none;
    margin-bottom: 100px;
}
.center {
    color: #03b4ff;
}
.musicActive .left image {
    width: 60px;
    height: 60px;
}

.list {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background: rgba(40, 41, 45, 1);
    z-index: 999;
    padding: 20px 0 0;
    overflow: hidden;white-space: initial;
    max-height: 60vh;
}
.playLeft {
    font-size: 0;
    padding-right: 10px;
}
.playLeft  image {
    width: 45px;
    height: 45px;
    border-radius: 10px;
}
.playRight {
    width:100%;
}

.info {
    display: inline-block;
    white-space: nowrap;
    width: 70%;
    overflow: hidden;
    text-overflow: ellipsis;
}

.play {
    display: flex;
    align-items: center;
}

.bofang {
    width: 23px;
    margin-right: 16px;
}

.bofang1 {
    width: 25px;
    margin-right: 16px;
}

.bofang2 {
    width: 20px;
}
.playView {
    display: flex;
    width: 100%;
    align-items: center;
}

.top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
}